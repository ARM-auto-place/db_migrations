MIGRATION_DIR=payments
PG_ADDRESS=$(vault kv get -field=haproxy_pgsql_master_2 services/monetization/prd/monetization-monetka-pgsql-cl1/pgsql_endpoints)
PG_DB=$(vault kv get -field=database services/monetization/prd/monetization-monetka-pgsql-cl1/payments_rw)
PG_USER=$(vault kv get -field=user services/monetization/prd/monetization-monetka-pgsql-cl1/user_admin)
PG_PASSWORD=$(vault kv get -field=password services/monetization/prd/monetization-monetka-pgsql-cl1/user_admin)
DB_INSTANCE=monetization-monetka-pgsql-cl1
